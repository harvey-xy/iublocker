{
  "name": "iublocker-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source Manifest V3 content blocker for modern Chrome",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter @iublocker/shared --filter @iublocker/scriptlets --filter @iublocker/compiler build && pnpm --filter @iublocker/extension build",
    "build:e2e": "IUB_E2E=1 pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "rulesets:fetch": "tsx tools/fetch-lists.ts",
    "rulesets:build": "tsx packages/compiler/src/cli/index.ts --lists tools/filterlists.json --cache .cache/lists --out packages/extension/rulesets",
    "delta": "tsx tools/make-delta.ts",
    "package": "tsx tools/package.ts",
    "e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "jsdom": "^26.0.0",
    "@types/jsdom": "^21.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  },
  "type": "module"
}
